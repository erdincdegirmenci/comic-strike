{
  "name": "comicstrike",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "server", "client"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"node --watch server/src/index.js --no-browser\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "node server/src/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
