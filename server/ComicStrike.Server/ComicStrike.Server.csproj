<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ComicStrike.Server</RootNamespace>
    <AssemblyName>ComicStrike</AssemblyName>
    <Version>0.2.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Oyun dosyaları "game" klasöründen EXE'nin içine gömülür; wwwroot kullanmıyoruz -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- npm run build → client'i buraya derler. Her dosya EXE içine "game/..." adıyla gömülür. -->
    <Content Remove="game\**" />
    <None Remove="game\**" />
    <EmbeddedResource Include="game\**" LogicalName="game/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

</Project>
